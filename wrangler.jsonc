{
  // ラッフレア: 静的な画面(ASSETS)+通知用のWorker。/api/* だけ Worker が先に処理する。
  "name": "pokeka-lottery",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [{ "binding": "SUBS" }],
  "triggers": { "crons": ["*/30 * * * *"] }
}
